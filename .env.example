# ============================================================================
# TxGuard × PayPal AI Risk Orchestration & Agentic Commerce Configuration
# ============================================================================
# Note: Leave credentials blank to run in Hybrid Sandbox Emulator Mode
# (works out-of-the-box with zero configuration for hackathon judging).

# 1. PayPal Developer Platform Sandbox (https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# 2. Google Gemini API via google-genai SDK (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# 3. Two-Tier Cascading Authorization Gate Policy Thresholds
TXGUARD_STEP_UP_THRESHOLD=0.45
TXGUARD_AUTO_BLOCK_THRESHOLD=0.85
